# Enterprise Financial Planning & Forecasting Engine
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# PostgreSQL connection string
# Local:  postgresql://user:password@localhost:5432/northstar_financial
# Neon:   postgresql://user:password@ep-xxxx.region.aws.neon.tech/northstar_financial?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/northstar_financial

# Application environment: development | production
APP_ENV=development

# Enable debug logging
DEBUG=true

# Show demo data generation button in the UI
DEMO_MODE=true

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Random seed for reproducible synthetic data generation
DATA_SEED=42

# Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_ROWS=100000

# Default currency
DEFAULT_CURRENCY=EUR
